<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
    </startup>

    <!--
      Uygulama ayarlari.
        UpdateCheckRepositoryOwner : Surum denetiminin yapilacagi GitHub hesabi.
                                     Depoyu kendi hesabina fork'ladiysan bu degeri
                                     KENDI kullanici adinla degistirmelisin; aksi halde
                                     program baska birinin deposundaki version.txt'ye bakar.
        UpdateCheckRepositoryName  : Depo adi.
        TelegramBotToken           : BotFather'dan aldigin bot token'i. Bos birakilirsa
                                     Telegram ozelligi calismaz (program yine de acilir).
                                     Token'i program icindeki "Bot Token" kutusuna da
                                     yazabilirsin; bu durumda exe yanindaki telegram.ini
                                     dosyasina kaydedilir ve buradaki deger kullanilmaz.
    -->
    <appSettings>
        <add key="UpdateCheckRepositoryOwner" value="0xinspectorx0"/>
        <add key="UpdateCheckRepositoryName" value="Metin2-FishBot-AutoFish-Balikbotu-otomatik-balik-botu-metin2-level-botu-metin2-enerji-botu"/>
        <add key="TelegramBotToken" value=""/>
    </appSettings>

    <runtime>
        <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
            <dependentAssembly>
                <assemblyIdentity name="System.ComponentModel.Annotations" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
                <bindingRedirect oldVersion="0.0.0.0-4.2.1.0" newVersion="4.2.1.0"/>
            </dependentAssembly>
            <dependentAssembly>
                <assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
                <bindingRedirect oldVersion="0.0.0.0-4.0.4.1" newVersion="4.0.4.1"/>
            </dependentAssembly>
        </assemblyBinding>
    </runtime>
</configuration>
